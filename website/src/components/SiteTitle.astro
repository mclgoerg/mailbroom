---
import SiteTitle from "@astrojs/starlight/components/SiteTitle.astro";
import { VERSION, RELEASE_URL } from "../../release.mjs";
---
<div class="brand">
  <SiteTitle />
  <a class="version" href={RELEASE_URL} aria-label={`Release ${VERSION}`}>v{VERSION}</a>
</div>
<style>
  .brand { display: flex; align-items: center; gap: 0.5rem; min-width: 0; }
  .brand :global(.site-title) {
    color: var(--sl-color-white);
    font-size: 1.125rem;
    gap: 0.5rem;
  }
  .brand :global(.site-title img) { width: 32px; height: 32px; }
  .version {
    color: var(--sl-color-gray-2);
    font-size: 0.75rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .version:hover { text-decoration: underline; }
</style>
