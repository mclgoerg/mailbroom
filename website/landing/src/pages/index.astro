---
import hero from "../../../../docs/screenshots/groups-dark.png";
import heroLight from "../../../../docs/screenshots/groups-light.png";
import { DEMO_LIVE, GITHUB } from "../../site.mjs";

const title = "Inboxrake - self-hosted cleanup for a mailbox that piled up";
const description =
  "Inboxrake rakes an IMAP mailbox into tidy piles: group mail by sender, subject or thread, then trash, unsubscribe from or block whole groups at once.";
// Structured data: only facts the project states elsewhere (README, LICENSE).
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Inboxrake",
  description,
  url: "https://inboxrake.com/",
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Linux (Docker)",
  license: `${GITHUB}/blob/main/LICENSE`,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  sameAs: [GITHUB],
};
const heroAlt =
  "The group list: senders with mail counts, sizes, AI verdicts and quick filters";
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://inboxrake.com/" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Inboxrake" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://inboxrake.com/" />
    <meta property="og:image" content="https://inboxrake.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Same choice as the docs site (Starlight stores it in localStorage),
      // else the system setting.
      const t = localStorage.getItem("starlight-theme");
      document.documentElement.dataset.theme =
        t === "light" || t === "dark"
          ? t
          : matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark";
    </script>
  </head>
  <body>
    <header class="bar">
      <a class="brand" href="/">Inboxrake</a>
      <nav>
        <a href="/docs/">Docs</a>
        <a href={GITHUB}>GitHub</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <h1>Rake your mailbox into tidy piles.</h1>
        <p class="lead">
          Inboxrake is a self-hosted web app that rakes an IMAP mailbox into
          tidy piles: it scans everything, groups mails by sender, subject or
          thread with counts and sizes, and lets you trash, unsubscribe from
          or block whole groups at once. Optional AI review (Anthropic,
          OpenAI, Claude on Microsoft Foundry, or local models via Ollama,
          LM Studio or vLLM) suggests what is safe to delete.
        </p>
        <p class="cta">
          {DEMO_LIVE && <a class="btn primary" href="/demo/">Try the demo</a>}
          <a class={DEMO_LIVE ? "btn" : "btn primary"} href="#install">Install</a>
          <a class="btn" href="/docs/">Read the docs</a>
          <a class="btn" href={GITHUB}>GitHub</a>
        </p>
        <img class="shot only-dark" loading="eager" fetchpriority="high" src={hero.src} width={hero.width} height={hero.height} alt={heroAlt} />
        <img class="shot only-light" loading="lazy" src={heroLight.src} width={heroLight.width} height={heroLight.height} alt={heroAlt} />
      </section>

      <section class="promise">
        <h2>Nothing is deleted without asking</h2>
        <p>
          Everything is undoable - moves go to Trash with an Undo -{" "}
          <strong>except</strong> permanent deletion in Trash and Junk: the manual "delete permanently" actions confirm with exact counts, and opt-in purge rules only act after you have reviewed a report run. Scans are read-only, and nothing leaves your machine unless you turn on AI review (then only metadata, never mail bodies or attachments).
        </p>
        <p><a href="/docs/security/">Security &amp; privacy in detail</a></p>
      </section>

      <section id="install">
        <h2>Install</h2>
        <p>
          Needs Docker and an IMAP mailbox (Gmail, iCloud, Fastmail, Proton
          via Bridge, ...). For Proton Mail use <code>docker-compose.proton.yml</code>
          instead of the default compose file (it needs a Bridge image you
          provide - see its header).
        </p>
        <pre><code>git clone https://github.com/mclgoerg/inboxrake
cd inboxrake/deploy
cp .env.example .env        # optional edits - account setup happens in the UI
docker compose up -d</code></pre>
        <p>
          Open <code>http://localhost:8765</code>; on a fresh install a setup
          wizard walks you through provider, sign-in, folders, an optional
          login password and the first scan. Platform guides (Synology,
          Unraid, TrueNAS, Portainer, Raspberry Pi), plain{" "}
          <code>docker run</code> and every setting are in the{" "}
          <a href="/docs/install/">install guide</a>.
        </p>
      </section>
    </main>

    <footer>
      <span>MIT licensed. <em>Formerly Mailbroom.</em></span>
      <span>
        <a href={GITHUB + "/blob/main/LICENSE"}>License</a> ·{" "}
        <a href="/docs/">Docs</a> ·{" "}
        <a href={GITHUB}>GitHub</a> ·{" "}
        Security: <a href="mailto:security@inboxrake.com">security@inboxrake.com</a>
      </span>
    </footer>
  </body>
</html>

<style is:global>
  /* Starlight's look: its system font, gray scale and indigo accent. */
  :root {
    --bg: hsl(224, 10%, 10%);
    --bg-alt: hsl(224, 14%, 16%);
    --text: hsl(224, 6%, 77%);
    --strong: hsl(0, 0%, 100%);
    --line: hsl(224, 10%, 23%);
    --accent: hsl(224, 100%, 60%);
    --accent-text: hsl(224, 100%, 85%);
    --on-accent: hsl(224, 54%, 20%);
    --code: hsl(224, 10%, 23%);
    color-scheme: dark;
  }
  :root[data-theme="light"] {
    --bg: hsl(0, 0%, 100%);
    --bg-alt: hsl(224, 19%, 97%);
    --text: hsl(224, 10%, 23%);
    --strong: hsl(224, 10%, 10%);
    --line: hsl(224, 6%, 77%);
    --accent: hsl(234, 90%, 60%);
    --accent-text: hsl(234, 90%, 60%);
    --on-accent: hsl(0, 0%, 100%);
    --code: hsl(224, 20%, 94%);
    color-scheme: light;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
      "Helvetica Neue", Arial, "Noto Sans", sans-serif;
    font-size: 1rem;
    line-height: 1.7;
  }
  a { color: var(--accent-text); }
  h1, h2, strong { color: var(--strong); }
  h1 { font-size: 2.5rem; line-height: 1.2; margin: 0 0 1rem; }
  h2 { font-size: 1.5rem; line-height: 1.3; margin: 0 0 0.75rem; }
  code, pre { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  code { background: var(--code); padding: 0.1em 0.35em; border-radius: 4px; font-size: 0.9em; }
  pre { background: var(--code); padding: 1rem; border-radius: 6px; white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.5; }
  pre code { background: none; padding: 0; }
  .bar {
    display: flex; justify-content: space-between; align-items: center;
    padding: 0.75rem 1.5rem; background: var(--bg-alt); border-bottom: 1px solid var(--line);
  }
  .bar nav { display: flex; gap: 1.25rem; }
  .bar a { text-decoration: none; }
  .brand { color: var(--strong); font-weight: 600; font-size: 1.125rem; }
  main { max-width: 52rem; margin: 0 auto; padding: 3rem 1.5rem 1rem; }
  section { margin-bottom: 3rem; }
  .lead { font-size: 1.125rem; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1.5rem 0; }
  .btn {
    display: inline-block; padding: 0.5rem 1.25rem; border-radius: 999rem;
    border: 1px solid var(--line); color: var(--strong); text-decoration: none; font-weight: 600;
  }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .shot { display: block; width: 100%; height: auto; border: 1px solid var(--line); border-radius: 8px; }
  :root[data-theme="light"] .only-dark, :root:not([data-theme="light"]) .only-light { display: none; }
  .promise { background: var(--bg-alt); border: 1px solid var(--line); border-radius: 8px; padding: 1.25rem 1.5rem; }
  .promise p:last-child { margin-bottom: 0; }
  footer {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem;
    max-width: 52rem; margin: 0 auto; padding: 1.5rem; border-top: 1px solid var(--line);
    font-size: 0.875rem;
  }
</style>
