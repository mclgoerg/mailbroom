{
  "name": "inboxrake-docs",
  "private": true,
  "type": "module",
  "description": "Static site (landing page + documentation), docs built from ../docs. Never shipped in the app image.",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && astro build --config landing/astro.config.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "dev:landing": "astro dev --host 127.0.0.1 --config landing/astro.config.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.6",
    "@astrojs/starlight": "0.42.9",
    "astro": "7.4.7"
  }
}
