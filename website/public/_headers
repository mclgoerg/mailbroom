# Cloudflare Pages response headers (copied to the site root by the build).
# Only the in-browser demo needs any: everything it loads under /demo/ except
# the entry points is content-hashed, so it can be cached for a year.
# Rules are additive per header, so the specific no-cache rules below detach
# (`!`) what the broad rules set before re-setting it.

# the demo's bundle: pyodide-<ver>-<hash>/, app.<hash>.zip, seed.<hash>.zip
/demo/bundle/*
  Cache-Control: public, max-age=31536000, immutable

# the UI build: hashed JS/CSS, and the Pyodide worker (hashed too)
/demo/assets/*
  Cache-Control: public, max-age=31536000, immutable

# the entry points are the only un-hashed files: always revalidate
/demo/bundle/manifest.json
  ! Cache-Control
  Cache-Control: no-cache

/demo/
  Cache-Control: no-cache

/demo/index.html
  Cache-Control: no-cache
