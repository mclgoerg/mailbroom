# Cloudflare Workers static assets response headers (copied to the site root by the build).
# Rules are additive per header, so the specific no-cache rules at the bottom
# detach (`!`) what the broad rules set before re-setting it.
# No HSTS here: Always Use HTTPS + HSTS are switched on in Cloudflare itself.
# No full Content-Security-Policy either: the in-browser demo needs wasm,
# workers and blob: URLs. Only framing is forbidden.

# every page
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

# the demo's bundle: pyodide-<ver>-<hash>/, app.<hash>.zip, seed.<hash>.zip
/demo/bundle/*
  Cache-Control: public, max-age=31536000, immutable

# the UI build: hashed JS/CSS, and the Pyodide worker (hashed too)
/demo/assets/*
  Cache-Control: public, max-age=31536000, immutable

# the docs' hashed JS/CSS/fonts
/docs/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# the entry points are the only un-hashed files: always revalidate
/demo/bundle/manifest.json
  ! Cache-Control
  Cache-Control: no-cache

/demo/
  Cache-Control: no-cache

/demo/index.html
  Cache-Control: no-cache
