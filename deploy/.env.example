# Mailbroom starter configuration. Everything here is a BOOTSTRAP - the
# settings UI can change all of it at runtime (saved to the /data volume,
# which then wins over this file).

# ------------------------------------------------------------- IMAP ----
# Leave this whole block commented out (default) to set up your first
# account in the UI's onboarding wizard instead - the quickest path for
# most people. Uncomment it only for a headless / infra-as-code setup
# that should come up fully configured with no UI interaction; it
# bootstraps ONE account only (add more later in the UI).
#
# Proton Bridge: 127.0.0.1 / 1143 / ssl (with docker-compose.proton.yml).
# Other providers (see the README table), e.g. iCloud:
#   IMAP_HOST=imap.mail.me.com  IMAP_PORT=993  SMTP_HOST=smtp.mail.me.com
#   SMTP_PORT=587 SMTP_SECURITY=starttls IMAP_CAFILE=
#
# IMAP_HOST=127.0.0.1
# IMAP_PORT=1143
# IMAP_SECURITY=ssl              # ssl | starttls
# IMAP_USER=you@example.com
# IMAP_PASSWORD=change-me        # bridge password / app password
# # CA file for self-signed certs (Proton Bridge). LEAVE EMPTY for normal
# # providers, otherwise their TLS verification fails:
# IMAP_CAFILE=/certs/bridge-cert.pem
#
# # SMTP is only used to send unsubscribe mails.
# SMTP_HOST=                     # empty = same as IMAP_HOST
# SMTP_PORT=1025
# SMTP_SECURITY=auto             # auto | ssl | starttls

# ------------------------------------------------------------ LOGIN ----
# none     = no login: keep the port on localhost / behind a reverse
#            proxy with its own auth (the default trust model)
# password = one shared password
# oidc     = SSO via an OpenID Connect provider (Pocket ID, Authentik,
#            Keycloak, ...). Register the app there first with callback
#            URL  https://<your-host>/api/oidc/callback
AUTH_MODE=none
AUTH_PASSWORD=
OIDC_ISSUER=                   # e.g. https://id.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED=                  # comma-separated emails; empty = any IdP user
OIDC_REDIRECT_BASE=            # only needed if auto-detection via
                               # X-Forwarded headers doesn't work
# With SSO every identity gets its OWN workspace; the admin owns the
# pre-existing one plus the server settings (empty = the first OIDC
# login claims it):
OIDC_ADMIN=

# --------------------------------------------------------------- AI ----
# Optional; can also be configured in the settings UI.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# ------------------------------------------------------------- MISC ----
# Read by docker-compose.yml, not the app itself. 127.0.0.1 keeps the UI
# off the network unless you set AUTH_MODE above or put a reverse proxy
# with its own auth in front - only then consider 0.0.0.0 (Docker ports
# bypass ufw, so this is a real exposure otherwise).
MAILBROOM_BIND=127.0.0.1
MAILBROOM_PORT=8765

# Encrypt stored secrets (IMAP passwords, API keys, OIDC client secret)
# at rest - protects volume backups. Generate:  openssl rand -base64 32
# Keep this key OUT of the backups; if it is lost, re-enter the secrets.
MAILBROOM_SECRET_KEY=
LOG_LEVEL=INFO
